    "preview": "vite preview",
    "test": "node server/phone-test.mjs && node server/order-test.mjs && node server/race-test.mjs",
    "test:phone": "node server/phone-test.mjs",
    "test:order": "node server/order-test.mjs",
    "test:race": "node server/race-test.mjs",
    "stock": "node server/stock.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
